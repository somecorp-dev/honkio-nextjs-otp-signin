# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your HonkIO API key, from https://honkio.ca/dashboard/keys
# Start with a test key (mk_test_...): nothing is sent and nothing is charged.
HONKIO_API_KEY=

# The number the codes are sent from, in E.164 (+1 and ten digits).
# Live key: one of your HonkIO numbers.
# Test key: any valid Canadian number works, so you can try this before you buy one.
HONKIO_FROM_NUMBER=

# The name shown in the text: "Your <APP_NAME> verification code is: 123456".
# Plain letters and numbers. A long name can make the text two segments.
APP_NAME=Acme

# Signs the session cookie. At least 32 random characters, for example the
# output of: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# Optional, for a demo only. A test key's code is always 000000, so anyone
# could sign in as any number. When NODE_ENV is production (`npm start` and
# every host), the app refuses to sign anyone in with a test key and logs
# why, unless this is true.
# ALLOW_TEST_MODE_SIGNIN=true

# How many proxies in front of the app add to X-Forwarded-For. Required in
# production, except on Vercel and Fly.io, which pass the visitor's IP in
# their own header. 0 for a bare `next start` with nothing in front (the
# per-IP limit is then off; the per-number limits stay), 1 behind one proxy
# (Railway, Render, nginx). Defaults to 1 in development.
# TRUSTED_PROXY_HOPS=1
